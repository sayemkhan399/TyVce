{
  "manifest_version": 3,
  "name": "TyVce — Voice typing",
  "description": "Dictate text into the webpage field at your cursor.",
  "version": "1.0.0",
  "minimum_chrome_version": "116",
  "permissions": [
    "activeTab",
    "scripting",
    "sidePanel"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open TyVce voice typing"
  },
  "side_panel": {
    "default_path": "index.html"
  }
}
